# Path to the model directory
# Every node must select the same model
MODEL_PATH=/path/to/your/model

# cpu, cuda, None
DEVICE=cpu

# 0, 1
PROFILE=1

# Quantizese intermediate activations before transmission
# 0, 1
QUANTIZE=1

# INFO, WANRING, ERROR
LOG_LEVEL=INFO

# 0, 1. Saves server delays to a file before exiting
BENCHMARK=0

# Number of layers to load on this node
NUM_LAYERS=10

# The IP address of this device (optional, auto-detected if not set)
IP=192.168.1.X

# Optional, a port will be selected automatically if not set
GPRC_PORT=5001
CLIENT_PORT=5002

# Address of the bootstrap node (optional, it can be detected through udp discovery)
BOOTSTRAP_NODE_ADDR=192.168.1.X:5001